#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Xquik contributors
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ -n "${XQUIK_FUZZ_HOST:-}" ]]; then
  [[ "$XQUIK_FUZZ_HOST" =~ ^[a-zA-Z0-9][a-zA-Z0-9@._-]*$ ]] || { echo 'Invalid SSH host.' >&2; exit 2; }
  tar --exclude='.env*' --exclude='__pycache__' -czf - \
    src pyproject.toml uv.lock README.md LICENSE scripts/fuzz scripts/audit .clusterfuzzlite/fuzz_querystring.py |
    ssh -- "$XQUIK_FUZZ_HOST" 'set -eu; umask 077; work=$(mktemp -d); echo "Remote fuzz source: $work" >&2; tar -xzf - -C "$work"; cd "$work"; unset XQUIK_FUZZ_HOST; bash scripts/fuzz'
  exit
fi

[[ "$(uname -s):$(uname -m)" == Linux:x86_64 ]] || { echo 'Use Linux x86_64 or set XQUIK_FUZZ_HOST to an authorized Linux SSH runner.' >&2; exit 1; }
export PATH="$HOME/.local/bin:$PATH" UV_PYTHON=3.14.7
[[ "$(uv --version)" == 'uv 0.12.13 '* ]] || { echo 'Install uv 0.12.13 on the fuzz runner.' >&2; exit 1; }
uv sync --locked --all-extras --group fuzz
bash scripts/audit
sanitizer=$(uv run --locked --no-sync python -c 'import atheris,pathlib; print(pathlib.Path(atheris.path()) / "asan_with_fuzzer.so")')
[[ -f "$sanitizer" ]] || { echo 'Atheris AddressSanitizer runtime is missing.' >&2; exit 1; }
evidence=$(mktemp -d)
mkdir "$evidence/corpus"
echo "Fuzz evidence: $evidence"
systemd-run --user --wait --pipe \
  -p PrivateNetwork=yes -p NoNewPrivileges=yes -p MemoryMax=3G -p CPUQuota=100% \
  -p ProtectSystem=strict -p ProtectHome=read-only -p "ReadWritePaths=$evidence" \
  -p RuntimeMaxSec=240 -p "WorkingDirectory=$PWD" \
  /usr/bin/env "LD_PRELOAD=$sanitizer" ASAN_OPTIONS=detect_leaks=0:symbolize=1 \
  "$PWD/.venv/bin/python" "$PWD/.clusterfuzzlite/fuzz_querystring.py" "$evidence/corpus" \
  -max_total_time=180 -max_len=4096 -rss_limit_mb=2048 -timeout=60 "-artifact_prefix=$evidence/" 2>&1 | tee "$evidence/run.log"
