#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Xquik contributors
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail
report="${COVERAGE_PARENT_REPORT:-}"
if [[ -n "$report" && "$report" != /* ]]; then report="$PWD/$report"; fi
cd "$(dirname "$0")/.."
source scripts/cleanup.sh
project="$PWD"
export UV_PYTHON=3.14.8
export COVERAGE_RCFILE="$project/pyproject.toml"
revision=$(git rev-parse --verify "${1:-HEAD^}^{commit}")
report="${report:-$(git rev-parse --path-format=absolute --git-path xquik-parent-coverage.json)}"
cleanup_traps
cleanup_temp_dir evidence xquik-python-parent
cleanup_worktree "$evidence/source"
git worktree add --detach "$evidence/source" "$revision"
cd "$evidence/source"
export COVERAGE_FILE="$evidence/.coverage"
export PYTHONPATH="$PWD/src:$PWD"
uv run --project "$project" --locked python "$project/scripts/coverage_sources.py" snapshot "$evidence/sources.json"
for combination in 3.10.22:pydantic-v1 3.10.22:pydantic-v2 3.14.8:pydantic-v2; do
  UV_PYTHON="${combination%%:*}" uv run --project "$project" --locked --isolated --all-extras --group "${combination#*:}" \
    coverage run --parallel-mode --branch --source=src/x_twitter_scraper,scripts,tests,.clusterfuzzlite \
    -m pytest -n 0 -q -rs >"$evidence/$combination.log" 2>&1 &
  cleanup_track "$!"
done
failed=0
cleanup_wait_all || failed=1
cat "$evidence"/*.log
((failed == 0)) || exit 1
uv run --project "$project" --locked coverage combine --keep "$evidence"
uv run --project "$project" --locked coverage json -o "$evidence/report.json"
uv run --project "$project" --locked python "$project/scripts/coverage_sources.py" attach "$evidence/report.json" "$evidence/sources.json"
uv run --project "$project" --locked python "$project/scripts/coverage_sources.py" verify-parent "$evidence/report.json" "$revision"
cp "$evidence/report.json" "$report"
printf 'Historical skips remain baseline gaps, not release passes.\nParent coverage: %s\n' "$report"
if [[ -n "${COVERAGE_PARENT_OUTPUT:-}" ]]; then printf 'report=%s\nrevision=%s\n' "$report" "$revision" >>"$COVERAGE_PARENT_OUTPUT"; fi
