#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Xquik contributors
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/cleanup.sh
minimum_version=2.27.2
codeql="${XQUIK_CODEQL_BIN:-$(command -v codeql || true)}"
[[ -x "$codeql" ]] || { echo "CodeQL CLI is missing. Install it with brew install --cask codeql, then rerun." >&2; exit 1; }
version=$("$codeql" version --format=terse)
[[ "$(printf '%s\n' "$minimum_version" "$version" | sort -V | head -n 1)" == "$minimum_version" ]] ||
  { echo "CodeQL CLI $version is older than $minimum_version. Run brew upgrade --cask codeql." >&2; exit 1; }
if [[ "${1:-}" == --version ]]; then
  echo "$version"
  exit
fi
echo "CodeQL CLI $version"
cleanup_traps
cleanup_temp_dir report xquik-python-codeql
"$codeql" pack install codeql/no-code-comments
"$codeql" database create "$report/database" --language=python --build-mode=none --source-root="$PWD" --threads=2
"$codeql" database analyze --download "$report/database" codeql/python-queries@1.8.12:codeql-suites/python-security-extended.qls codeql/no-code-comments --format=sarifv2.1.0 --output="$report/report.sarif" --threads=2
cat "$report/report.sarif"
uv run --locked --all-extras python scripts/verify_codeql.py "$report/report.sarif"
